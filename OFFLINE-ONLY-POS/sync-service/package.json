{
  "name": "@shelfpos/sync-service",
  "version": "1.6.4",
  "description": "Background OS service: SQLite sync_queue → Supabase mirror",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "backfill": "node scripts/backfill-mirror.cjs",
    "queue:diagnose": "node scripts/diagnose-queue.cjs",
    "queue:compact": "node scripts/compact-sync-queue.cjs",
    "fix:deltas": "node scripts/fix-bad-deltas.cjs",
    "install:windows": "node scripts/install-windows-service.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "node-windows": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}

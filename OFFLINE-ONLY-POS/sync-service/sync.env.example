# Production: %APPDATA%\shelfpos\sync.env (POS Settings or Install-ShelfPOS writes this file).
# Dev: copy here as sync-service/sync.env — `npm run dev` loads this when AppData file is absent.
SUPABASE_URL=https://your-project.supabase.co
# Encrypted with Windows DPAPI (dpapi:...) — only decrypts on this PC.
SUPABASE_SECRET_KEY=dpapi:...
SQLITE_PATH=C:/Users/You/AppData/Roaming/shelfpos/shelf.db
# One-time code from Dashboard → Vincular POS
STORE_PAIRING_CODE=

{
  "$schema": "https://www.react.doctor/schema/doctor.config.v1.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "sync-service/src/**/*.ts"],
  "ignore": [
    "dist/**",
    "node_modules/**",
    "out/**",
    ".output/**",
    "**/.output/**"
  ],
  "rules": {
    "react-doctor/async-await-in-loop": "off"
  }
}
